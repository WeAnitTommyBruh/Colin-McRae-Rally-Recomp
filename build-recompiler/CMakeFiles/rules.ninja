  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=CMakeFiles/disc_identity_test.dir/CXXDependInfo.json --lang=CXX --modmapfmt=gcc --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in
  restat = 1


#############################################
