+++ b/runtime/src/gpu.c
@@ -377,9 +377,19 @@ static int ws_game_mode(void) {
  * screens by projection count. The hysteresis rides out 1-2 frame gaps; a
  * real scene change crosses it in ~0.1 s. */
 #define WS_2D_SCENE_HYSTERESIS 6u
+/* Optional overhang gate for GTE-detector titles ([widescreen] gte_game_mode).
+ * The detector alone stamps ANY frame that projects >= 3 vertices, so a 2D menu
+ * that uses the GTE for a spinning globe or ring text counts as gameplay and is
+ * widened. With this gate on, such a frame is only gameplay if it also submits
+ * polygons that overhang the canonical window (the content native-wide reveals);
+ * frames without it present as 2D. Set by a trusted mod; off = old behaviour. */
+static int ws_gte_overhang_gate = 0;
+void psx_mod_set_gte_scene_overhang_gate(int enabled) {
+    ws_gte_overhang_gate = enabled ? 1 : 0;
+}
 static int ws_2d_only_scene(void) {
     if (ws_mod_world_scene()) return 0;
-    if (ws_full_2d_mode() || ws_gte_game_mode_cfg) return 0;
+    if (ws_full_2d_mode() || (ws_gte_game_mode_cfg && !ws_gte_overhang_gate)) return 0;
     return (uint32_t)s_frame_count - ws_sust_ovh_stamp > WS_2D_SCENE_HYSTERESIS;
 }
 
